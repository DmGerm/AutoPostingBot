@page "/"
@rendermode InteractiveServer
@inject IBotService BotService
@inject IPostsRepo PostsRepo
@inject IGroupRepo GroupRepo
@using System.Text.RegularExpressions
@using AutoPost_Bot.BotRepo
@using AutoPost_Bot.Models
@using AutoPost_Bot.PostsRepository
@using AutoPost_Bot.TelegramGroupsRepo
@using Microsoft.AspNetCore.Authorization
@implements IDisposable
@attribute [Authorize]

<PageTitle>Home</PageTitle>

<h1>Настройка бота</h1>
        <div class="input-group mb-3">
            <button class="btn btn-outline-secondary"
                    type="button"
                    id="button-addon1"
                    @onclick="() => ToggleBot(_allBots[_selectedBotIndex])">
                    @(_allBots[_selectedBotIndex].IsActive ? "Остановить бота" : "Запустить бота")
            </button>
            <input type="text"
                   class="form-control @(_hasError ? "is-invalid" : "")"
                   placeholder="Введите токен бота"
                   aria-label="Bot Token input form"
                   aria-describedby="button-addon1"
                   @bind="_allBots[_selectedBotIndex].Token"/>
        </div>

        @if (_hasError)
        {
            <div class="text-danger mb-3">Ошибка: @_errorMessage</div>
        }
        @if (_hasStatus)
        {
            <div class="text-success mb-3">@_statusMessage</div>
        }
        @if (_allBots[_selectedBotIndex].IsActive)
        {
            <div class="post_container">
                <h1>Настройка авто-постинга</h1>

        @if (_allBots[_selectedBotIndex].Posts.Any())
                {
                    <p>Постов для публикации еще нет</p>
                }
                else
                {
                    <p>Постов для публикации: @(_allBots[_selectedBotIndex].Posts.Count)</p>
                }

        @foreach (var post in _allBots[_selectedBotIndex].Posts)
                {
                    <div class="post-item mb-4" @key="post.Id">
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary dropdown-toggle mb-3"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                @GetGroupName(post.Group)
                            </button>
                            <ul class="dropdown-menu">
                                @foreach (var group in _allBots[_selectedBotIndex].Groups)
                                {
                                    <li>
                                        <a class="dropdown-item"
                                           href="#"
                                           @onclick="() => SelectGroup(post, group)">
                                            @group.Name
                                        </a>
                                    </li>
                                }
                            </ul>
                            <button type="button" class="btn btn-danger mb-3 ms-sm-3"
                                    @onclick="() => RemovePost(post)"
                            >Удалить пост
                            </button>
                        </div>

                        <div class="form-floating mb-3">
                            <textarea class="form-control post-textarea"
                                      @bind="post.PostText"
                                      placeholder="Введите текст поста"></textarea>
                            <label>Текст поста</label>
                        </div>

                        <div class="form-floating mb-3">
                            <input type="datetime-local" class="form-control"
                                   id="datetimeInput"
                                   @bind="post.PostDateTime"/>
                            <label for="datetimeInput">Дата и время публикации</label>
                        </div>

                        <div class="d-flex flex-column">
                            <label class="form-label mb-1">Выберите частоту повторения</label>
                            <div class="input-group d-flex gap-3 mb-3 mt-0">
                                <div class="form-floating">
                                    <input type="number"
                                           class="form-control"
                                           id="repeatDays"
                                           placeholder="0"
                                           min="0"
                                           @bind="post.RepeatDays"/>
                                    <label for="repeatDays">Дней</label>
                                </div>
                                <div class="form-floating">
                                    <input type="number"
                                           class="form-control"
                                           id="repeatHours"
                                           placeholder="0"
                                           min="0"
                                           max="23"
                                           @bind="post.RepeatHours"/>
                                    <label for="repeatHours">Часов</label>
                                </div>
                                <div class="form-floating">
                                    <input type="number"
                                           class="form-control"
                                           id="repeatMinutes"
                                           placeholder="0"
                                           min="0"
                                           max="59"
                                           @bind="post.RepeatMinutes"/>
                                    <label for="repeatMinutes">Минут</label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex flex-column">
                            <label class="form-label mb-1">Выберите дни повторения</label>

                            <div class="btn-group btn-group-sm" role="group" aria-label="Repeat days checkboxes">
                                <input type="checkbox"
                                       class="btn-check"
                                       id=@($"btncheck{buttonCount}")
                                       autocomplete="off"
                                       checked="@IsDayChecked(post, Days.Monday)"
                                       @onchange="() => DayAddOrRemove(post, Days.Monday)">
                                <label class="btn btn-outline-primary" 
                                       for=@($"btncheck{buttonCount++}")>Пн</label>

                                <input type="checkbox"
                                       class="btn-check"
                                       id=@($"btncheck{buttonCount}")
                                       autocomplete="off"
                                       checked="@IsDayChecked(post, Days.Tuesday)"
                                       @onchange="() => DayAddOrRemove(post, Days.Tuesday)">
                                <label class="btn btn-outline-primary" 
                                       for=@($"btncheck{buttonCount++}")>Вт</label>

                                <input type="checkbox"
                                       class="btn-check"
                                       id=@($"btncheck{buttonCount}")
                                       autocomplete="off"
                                       checked="@IsDayChecked(post, Days.Wednesday)"
                                       @onchange="() => DayAddOrRemove(post, Days.Wednesday)">
                                <label class="btn btn-outline-primary"
                                       for=@($"btncheck{buttonCount++}")>Ср</label>

                                <input type="checkbox"
                                       class="btn-check"
                                       id=@($"btncheck{buttonCount}")
                                       autocomplete="off"
                                       checked="@IsDayChecked(post, Days.Thursday)"
                                       @onchange="() => DayAddOrRemove(post, Days.Thursday)">
                        <label class="btn btn-outline-primary" for=@($"btncheck{buttonCount++}")>Чт</label>

                                <input type="checkbox"
                                       class="btn-check"
                                       id=@($"btncheck{buttonCount}")
                                       autocomplete="off"
                                       checked="@IsDayChecked(post, Days.Friday)"
                                       @onchange="() => DayAddOrRemove(post, Days.Friday)">
                        <label class="btn btn-outline-primary" for=@($"btncheck{buttonCount++}")>Пт</label>

                                <input type="checkbox"
                                       class="btn-check"
                                       id=@($"btncheck{buttonCount}")
                                       autocomplete="off"
                                       checked="@IsDayChecked(post, Days.Saturday)"
                                       @onchange="() => DayAddOrRemove(post, Days.Saturday)">
                        <label class="btn btn-outline-primary" for=@($"btncheck{buttonCount++}")>Сб</label>

                                <input type="checkbox"
                                       class="btn-check"
                                       id=@($"btncheck{buttonCount}")
                                       autocomplete="off"
                                       checked="@IsDayChecked(post, Days.Sunday)"
                                       @onchange="() => DayAddOrRemove(post, Days.Sunday)">
                        <label class="btn btn-outline-primary" for=@($"btncheck{buttonCount++}")>Вс</label>
                            </div>
                        </div>
                    </div>
                }

                <div class="d-flex gap-3">
                    <button type="button"
                            class="btn btn-primary"
                            @onclick="() => SaveChanges(true)">
                        Сохранить изменения
                    </button>

                    <button type="button"
                            class="btn btn-success"
                            @onclick="AddPost">
                        Добавить пост
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="text-bg-primary p-3">Для управления постами запустите бот</div>
        }

@code {
    private Action? _groupRepoChangedHandler;
    private Dictionary<int, BotModel> _allBots = new();
    private bool _hasError;
    private bool _hasStatus;
    private string _errorMessage = string.Empty;
    private string _statusMessage = string.Empty;
    private bool _isDisposed;
    private int buttonCount = 1;
    private int _selectedBotIndex = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            buttonCount = 1;
            _allBots = BotService.GetBotModels().Select((botmodel, index) => (index, botmodel))
                                                 .ToDictionary(x => x.Item1, x => x.Item2)
												 ?? throw new Exception(@"Exception in Home, can't load boats.");

            if (_allBots.Count == 0)
            {
                _allBots[0] = new BotModel
                {
                    Token = string.Empty,
                    IsActive = false,
                    Groups = new List<GroupModel>()
				};
            }

            _allBots[_selectedBotIndex].Posts = await PostsRepo.GetPostsByBotTokenAsync(_allBots[_selectedBotIndex].Token);

            _groupRepoChangedHandler = () => _ = OnGroupRepoChanged();
            GroupRepo.StateChanged += _groupRepoChangedHandler;
        }
        catch (Exception ex)
        {
            HandleError("Ошибка инициализации: " + ex.Message);
        }
    }

    private string GetGroupName(GroupModel group)
    {
        if (group == null)
            return "Выберите канал или группу";

        return String.IsNullOrEmpty(group.Name)
            ? group.Name
            : "Группа не найдена";
    }

    private async Task ToggleBot(BotModel bot)
    {
        _hasError = false;
        _hasStatus = false;

        try
        {
            if (bot.IsActive)
            {
                await BotService.StopBot(bot.Token);
                ShowStatus("Бот успешно остановлен!");
            }
            else
            {
                if (!ValidateBotToken())
                    return;

                await BotService.StartBot(bot.Token);
                ShowStatus("Бот успешно запущен!");
            }
        }
        catch (Exception ex)
        {
            HandleError(ex.Message);
        }
    }

    private bool ValidateBotToken()
    {
        const string pattern = @"^(?:\w+):(?:[\w:]+)";
        if (Regex.IsMatch(_allBots[_selectedBotIndex].Token, pattern))
            return true;

        HandleError("Неверный формат токена");
        return false;
    }

    private void SelectGroup(PostModel post, GroupModel group)
    {
        post.Group = group;
		post.GroupId = group.GroupId;
        StateHasChanged();
    }

    private void AddPost()
    {
        _allBots[_selectedBotIndex].Posts.Add(new PostModel
        {
            Id = Guid.NewGuid(),
            PostText = string.Empty,
            PostDateTime = DateTime.Now,
            RepeatDays = 0,
            RepeatHours = 0,
            RepeatMinutes = 0
        });

        StateHasChanged();
    }

    private async Task SaveChanges(bool isNotificationOn)
    {
        try
        {
            await BotService.UpdateBotModel(_allBots[_selectedBotIndex]);

            if (isNotificationOn)
                ShowStatus("Изменения успешно сохранены!");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка при сохранении постов: {ex.Message} {ex.InnerException.StackTrace}");
            HandleError("Ошибка сохранения: " + ex.Message);
        }
    }

    private void HandleError(string message)
    {
        _hasError = true;
        _errorMessage = message;
        _hasStatus = false;
        StateHasChanged();
    }

    private void ShowStatus(string message)
    {
        _hasStatus = true;
        _statusMessage = message;
        _hasError = false;
        StateHasChanged();
    }

    private async Task OnGroupRepoChanged()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                StateHasChanged();
            });
        }
        catch (Exception e)
        {
            Console.WriteLine($"Ошибка в обработчике GroupRepo: {e.Message}");
        }
    }

    public void Dispose()
    {
        if (!_isDisposed && _groupRepoChangedHandler is not null)
        {
            GroupRepo.StateChanged -= _groupRepoChangedHandler;
            _isDisposed = true;
        }
    }

    private Task RemovePost(PostModel post)
    {
        try
        {
            _allBots[_selectedBotIndex].Posts.Remove(post);
        }
        catch (Exception e)
        {
            Console.WriteLine($"Ошибка при удалении поста {e.Message}");
        }

        return Task.CompletedTask;
    }

    private bool IsDayChecked(PostModel post, Days day)
    {
        if (post.Days.HasFlag(day))
        {
            return true;
        }
        return false;
    }

    private Task DayAddOrRemove(PostModel post, Days day)
    {
        if (post.Days.HasFlag(day))
        {
            post.Days &= ~day;
        }
        else
        {
            post.Days |= day;
        }
        StateHasChanged();
        return Task.CompletedTask;
    }
}
